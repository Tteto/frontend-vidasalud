# Copia este archivo como .env y reemplaza con los valores reales
# que anotaste al configurar Azure AD (App Registrations).

# Tenant ID del directorio de Azure AD
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Client ID de la App Registration del FRONTEND (vidasalud-spa)
VITE_AZURE_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client ID de la App Registration de la API (vidasalud-api)
# Se usa para construir el scope api://<este-id>/access_as_user
VITE_AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# URL donde vive tu BFF (local o EC2). El API Gateway pega delante del BFF
# o, si el gateway apunta directo al BFF, esta es la URL del gateway.
VITE_BFF_BASE_URL=http://localhost:8080
